# Copy outside the repository, protect with chmod 600, and supply --env-file.
# Use a long random hexadecimal password (URL-safe).
POSTGRES_PASSWORD=replace-with-a-long-random-hexadecimal-password
PUBLIC_API_URL=https://api.example.org
# localhost is required by the container readiness probe.
ALLOWED_HOSTS=api.example.org,localhost,127.0.0.1
CORS_ORIGINS=https://app.example.org
PRODUCTION_PORT=8002
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=Saraang <noreply@example.org>
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SSL=false
