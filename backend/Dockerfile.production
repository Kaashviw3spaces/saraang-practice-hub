FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY backend/requirements.production.lock ./requirements.production.lock
RUN pip install --no-cache-dir -r requirements.production.lock && useradd --uid 10001 --create-home app
COPY backend/ ./
COPY sql/ ./sql/
USER app
EXPOSE 8000
CMD ["uvicorn", "production:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
