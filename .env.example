# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saraang_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection Strings
# For local apps running directly on host machine:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saraang_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Backend API Configuration
BACKEND_PORT=8001
